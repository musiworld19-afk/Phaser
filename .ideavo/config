{
  "systemSetup": [],
  "templateName": "custom",
  "projectDependencies": [
    {
      "name": "Install Dependencies",
      "command": "npm install"
    }
  ],
  "codeChecks": [
    {
      "name": "Run Unit Tests",
      "command": "npm test"
    }
  ],
  "buildSteps": [
    {
      "name": "Build Project",
      "command": "npm run build"
    }
  ],
  "runStep": [
    {
      "name": "Run Dev Server",
      "command": "npm run dev -- --host 0.0.0.0 --port 8080",
      "port": "8080"
    }
  ],
  "deploySteps": [
    {
      "name": "Deploy Static Build",
      "command": "npx vercel deploy dist --prod"
    }
  ],
  "cleanupFiles": [
    "node_modules",
    "dist",
    "e2e/screenshots"
  ],
  "packageManager": "npm",
  "envPaths": [
    {
      "name": "default",
      "path": ".env"
    }
  ]
}
